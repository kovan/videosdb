{:paths ["src/main" "src/shared" "resources"]

 :deps {;; Clojure
        org.clojure/clojure                {:mvn/version "1.12.0"}
        org.clojure/tools.logging          {:mvn/version "1.3.0"}
        org.clojure/data.json              {:mvn/version "2.5.0"}
        org.clojure/tools.cli              {:mvn/version "1.1.230"}
        org.clojure/core.async             {:mvn/version "1.6.681"}

        ;; Firestore
        com.google.firebase/firebase-admin {:mvn/version "9.2.0"}

        ;; HTTP client
        hato/hato                          {:mvn/version "1.0.0"}

        ;; Redis
        com.taoensso/carmine               {:mvn/version "3.4.0"}

        ;; Pathom 3
        com.wsscode/pathom3                {:mvn/version "2023.08.22-alpha"}

        ;; Fulcro
        com.fulcrologic/fulcro             {:mvn/version "3.7.10"}

        ;; Slug generation
        com.github.slugify/slugify         {:mvn/version "3.0.7"}

        ;; Logging
        ch.qos.logback/logback-classic     {:mvn/version "1.5.6"}

        ;; Process management (for SSR)
        babashka/process                   {:mvn/version "0.5.22"}

        ;; JSON Schema validation
        com.networknt/json-schema-validator {:mvn/version "1.4.0"}}

 :aliases
 {:dev  {:extra-paths ["src/client" "test"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "2.28.10"}}}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1"
                        :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  :cli  {:main-opts ["-m" "videosdb.cli"]}

  :build {:deps  {io.github.clojure/tools.build {:mvn/version "0.10.4"}}
          :ns-default build}}}
