<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%level\t%date{yyyy-MM-dd HH:mm:ss}:%logger.%method (%file:%line): %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="videosdb" level="${LOGLEVEL:-INFO}" />
  <logger name="com.google" level="WARN" />
  <logger name="io.grpc" level="WARN" />

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
