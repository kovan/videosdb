<?xml version="1.0" encoding="utf-8" standalone="no"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <RestoreSuccess Condition=" '$(RestoreSuccess)' == '' ">False</RestoreSuccess>
    <RestoreTool Condition=" '$(RestoreTool)' == '' ">NuGet</RestoreTool>
    <ProjectAssetsFile Condition=" '$(ProjectAssetsFile)' == '' ">$(MSBuildThisFileDirectory)project.assets.json</ProjectAssetsFile>
    <NuGetPackageRoot Condition=" '$(NuGetPackageRoot)' == '' ">/home/k/.nuget/packages/</NuGetPackageRoot>
    <NuGetPackageFolders Condition=" '$(NuGetPackageFolders)' == '' ">/home/k/.nuget/packages/</NuGetPackageFolders>
    <NuGetProjectStyle Condition=" '$(NuGetProjectStyle)' == '' ">PackageReference</NuGetProjectStyle>
    <NuGetToolVersion Condition=" '$(NuGetToolVersion)' == '' ">7.0.0</NuGetToolVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <SourceRoot Include="/home/k/.nuget/packages/" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <PkgSystem_Text_Json Condition=" '$(PkgSystem_Text_Json)' == '' ">/home/k/.nuget/packages/system.text.json/8.0.0</PkgSystem_Text_Json>
    <PkgStackExchange_Redis Condition=" '$(PkgStackExchange_Redis)' == '' ">/home/k/.nuget/packages/stackexchange.redis/2.6.66</PkgStackExchange_Redis>
    <PkgNodaTime Condition=" '$(PkgNodaTime)' == '' ">/home/k/.nuget/packages/nodatime/3.1.0</PkgNodaTime>
    <PkgNJsonSchema Condition=" '$(PkgNJsonSchema)' == '' ">/home/k/.nuget/packages/njsonschema/11.0.0</PkgNJsonSchema>
    <PkgGoogle_Cloud_Firestore Condition=" '$(PkgGoogle_Cloud_Firestore)' == '' ">/home/k/.nuget/packages/google.cloud.firestore/3.8.0</PkgGoogle_Cloud_Firestore>
    <PkgGoogle_Apis_YouTube_v3 Condition=" '$(PkgGoogle_Apis_YouTube_v3)' == '' ">/home/k/.nuget/packages/google.apis.youtube.v3/1.63.0.3205</PkgGoogle_Apis_YouTube_v3>
    <PkgFSharp_Core Condition=" '$(PkgFSharp_Core)' == '' ">/home/k/.nuget/packages/fsharp.core/10.0.100</PkgFSharp_Core>
    <PkgAngleSharp Condition=" '$(PkgAngleSharp)' == '' ">/home/k/.nuget/packages/anglesharp/1.0.1</PkgAngleSharp>
  </PropertyGroup>
</Project>